OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_CLIENT_ID=replace-me
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=0123456789abcdefghijklmnopqrstuv
OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/oauth2/callback
BAP_PUBLIC_PORT=8080
BAP_ALLOW_ANONYMOUS=true

# Host paths for bap-search data (bind mounts).
# Override with absolute paths to store data anywhere on the host:
# BAP_MODELS_PATH=/data/bapsearch/models
# BAP_LOGS_PATH=/data/bapsearch/logs
# BAP_DATABASE_PATH=/data/bapsearch/database

# NVIDIA preset for a small 4GB GPU
LLAMA_ANSWER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_ANSWER_THREADS=4
LLAMA_ANSWER_CTX_SIZE=8192
LLAMA_ANSWER_N_GPU_LAYERS=auto
LLAMA_ANSWER_MAIN_GPU=0
LLAMA_ANSWER_GPUS=all
LLAMA_ANSWER_FLASH_ATTN=true
LLAMA_ANSWER_EXTRA_ARGS=--batch-size 256 --ubatch-size 128 -fit off
# Speculative decoding (image must be >= b9274; `docker compose pull` refreshes):
# - ngram-mod : draftless, any model, strong on grounded answers quoting sources.
# - draft-mtp : MTP-native models (Qwen3.5/3.6, DeepSeek V3/R1, Gemma 4),
#               ~1.7x throughput on GPU. Entrypoint falls back to no-spec if
#               llama-server can't start with it.
LLAMA_ANSWER_SPEC_TYPE=draft-mtp
# LLAMA_ANSWER_SPEC_TYPE=ngram-mod
# LLAMA_ANSWER_SPEC_DRAFT_N_MAX=16
# KV-cache prefix reuse between calls sharing a prompt prefix (tokens; 0 = off).
LLAMA_ANSWER_CACHE_REUSE=256
LLAMA_EMBEDDINGS_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_EMBEDDINGS_THREADS=4
LLAMA_EMBEDDINGS_CTX_SIZE=2048
LLAMA_EMBEDDINGS_N_GPU_LAYERS=auto
LLAMA_EMBEDDINGS_MAIN_GPU=0
LLAMA_EMBEDDINGS_GPUS=all
LLAMA_EMBEDDINGS_FLASH_ATTN=true
LLAMA_EMBEDDINGS_PARALLEL=4
LLAMA_EMBEDDINGS_EXTRA_ARGS=--embeddings --pooling mean --batch-size 2048 --ubatch-size 2048 -fit off
LLAMA_AUTO_RELOAD_MODEL=false
# Max tokens of each page sent to the embedding model (also settable in /settings).
# BAP_MAX_EMBEDDING_TOKENS=500
BAP_CHAT_CONTEXT_CHARS=4200
BAP_MAX_CHAT_MESSAGES=8
BAP_LLM_CONTEXT_TOKENS=8192

# Structured log paths inside the backend container (mounted to ../logs by default).
# BAP_LOG_PATH=/logs/backend.jsonl       # general events
# BAP_LLM_LOG_PATH=/logs/llm.jsonl       # every LLM/embedding prompt, response, API call

# Create these files in models/ if you want fixed routing by role:
# - current-model.txt
# - current-embedding-model.txt

# Start with:
# docker compose -f docker/docker-compose.yml -f docker/docker-compose.gpu.yml up --build